# agent-wiki — LLM credentials.
#
# Copy this file to `.env` and fill in ONE of the four provider blocks
# below. The pipeline talks to any Anthropic-compatible Messages API
# endpoint (so OpenAI, Claude, Minimax, DeepSeek, Together, vLLM, etc.
# all work — only the base URL + key change).
#
# `.env` is gitignored. Never commit credentials.

# --- 1. Anthropic (Claude) — official ---------------------------------
# Best quality / Chinese coverage; pricier per token.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-5

# --- 2. Minimax (M2 series via Anthropic shim) -------------------------
# Cheap, strong Chinese; we ran the 196-book S5 batch on M2.7-highspeed
# for ~$104 total. Their endpoint speaks the Anthropic protocol.
# ANTHROPIC_API_KEY=eyJhbGciOi...   # Minimax JWT
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_MODEL=MiniMax-M2.7-highspeed

# --- 3. OpenAI (gpt-* via Anthropic-compatible proxy) ------------------
# Requires an OpenAI-key-→-Anthropic-protocol shim (e.g. LiteLLM in
# proxy mode, or one-api). Most LLM gateways do this for you.
# ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_BASE_URL=https://your-litellm-proxy.example.com
# LLM_MODEL=gpt-4o

# --- 4. DeepSeek (OpenAI-protocol, direct) -----------------------------
# Cheaper than Claude, strong Chinese, native OpenAI-compatible API
# (no shim needed). deepseek-chat = V3 general; deepseek-reasoner = R1.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- 5. Local (Ollama / vLLM / llama.cpp, OpenAI-protocol) -------------
# For air-gapped runs. OPENAI_BASE_URL points at your local server.
# OPENAI_API_KEY=any-non-empty-string
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:32b

# --- Pipeline tuning (optional) ----------------------------------------
# Per-chunk LLM workers in extract.py — raise for faster runs on big
# context windows; lower if you hit API rate limits.
# INGEST_PARALLEL_CHUNKS=4

# Marker (PyTorch OCR for scanned PDFs). Default OFF — marker loads
# multi-GB models that thrash a 16GB Mac. Use ocrmypdf (much lighter)
# instead via scripts/ingest/ocr_rescue.py.
# ENABLE_MARKER_OCR=0
# MARKER_BIN=/path/to/marker_single
